    {
      "name": "OP07 — General Inquiry",
      "item": [
        {
          "name": "01. What does gas lock mean in an ESP?",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Streams valid text delta response\", function () {",
                  "    var lines = pm.response.text().trim().split('\\n').map(function(l) { return JSON.parse(l); });",
                  "    var doneFrame = lines.find(function(f) { return f.type === 'done'; });",
                  "    pm.expect(doneFrame.status).to.eql(\"OK\");",
                  "    var textDelta = lines.find(function(f) { return f.type === 'text_delta'; });",
                  "    pm.expect(textDelta).to.not.be.undefined;",
                  "    pm.expect(textDelta.delta.toLowerCase()).to.include(\"gas\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{agent_url}}/query", "host": ["{{agent_url}}"], "path": ["query"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"session_id\": \"slice2-op07-01\",\n  \"message\": \"What does gas lock mean in an ESP?\"\n}"
            }
          }
        },
