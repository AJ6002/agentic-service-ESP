  "item": [
    {
      "name": "01. Agent Health Check",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Response time is within SLA (< 20000ms)\", function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(20000);",
              "});",
              "pm.test(\"Agent service is healthy and slice is 2\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.status).to.eql(\"HEALTHY\");",
              "    pm.expect(jsonData.service).to.eql(\"agent_service\");",
              "    pm.expect(jsonData.slice).to.eql(2);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{agent_url}}/health",
          "host": [
            "{{agent_url}}"
          ],
          "path": [
            "health"
          ]
        }
      },
      "response": []
    },
    {
      "name": "02. OP01 - Real-time Status Query",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Response time is within SLA (< 20000ms)\", function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(20000);",
              "});",
              "pm.test(\"Stream contains text delta and terminates cleanly with done\", function () {",
              "    var lines = pm.response.text().trim().split('\\n').map(function(l) { return JSON.parse(l); });",
              "    pm.expect(lines.length).to.be.above(2);",
              "    var doneFrame = lines[lines.length - 1];",
              "    pm.expect(doneFrame.type).to.eql(\"done\");",
              "    pm.expect(doneFrame.status).to.eql(\"OK\");",
              "    var textDelta = lines.find(function(f) { return f.type === 'text_delta'; });",
              "    pm.expect(textDelta).to.not.be.undefined;",
              "    pm.expect(textDelta.delta.length).to.be.above(10);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{agent_url}}/query",
          "host": [
            "{{agent_url}}"
          ],
          "path": [
            "query"
          ]
