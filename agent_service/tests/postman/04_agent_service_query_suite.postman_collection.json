    {
      "name": "06. Parameterized Query - Time Window + Tripped Well (show events for FNW-01 over the past 2 hours)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Response time is within SLA (< 25000ms)\", function () { pm.expect(pm.response.responseTime).to.be.below(25000); });",
              "var lines = pm.response.text().trim().split(\"\\n\").map(function(l) { return JSON.parse(l); });",
              "pm.test(\"NDJSON stream contains terminal done frame\", function () {",
              "    var doneFrame = lines[lines.length - 1];",
              "    pm.expect(doneFrame.type).to.eql(\"done\");",
              "    pm.expect(doneFrame.status).to.eql(\"OK\");",
              "});",
              "pm.test(\"Events window evaluated accurately\", function () {",
              "    var textDeltas = lines.filter(function(f) { return f.type === \"text_delta\"; }).map(function(f) { return f.delta; }).join(\"\");",
              "    pm.expect(textDeltas.toLowerCase()).to.satisfy(function(t) {",
              "        return t.includes(\"event\") || t.includes(\"fnw-01\") || t.includes(\"record\");",
              "    });",
              "});"
            ],
            "type": "text/javascript"
          }
        }
