	"item": [
		{
			"name": "01. Health Check",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"pm.test(\"Service is healthy and slice is 1\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.status).to.eql(\"HEALTHY\");",
							"    pm.expect(jsonData.service).to.eql(\"agent_service\");",
							"    pm.expect(jsonData.slice).to.eql(1);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/health",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"health"
					]
				}
			},
			"response": []
		},
		{
			"name": "02. Clean SIMPLE Query (Glossary)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"pm.test(\"Response is NDJSON and answers TDH\", function () {",
							"    var lines = pm.response.text().trim().split('\\n').map(function(l) { return JSON.parse(l); });",
							"    pm.expect(lines.length).to.be.at.least(2);",
							"    ",
							"    // Find text delta",
							"    var textDelta = lines.find(function(f) { return f.type === 'text_delta'; });",
							"    pm.expect(textDelta).to.not.be.undefined;",
							"    pm.expect(textDelta.delta.toLowerCase()).to.include(\"total dynamic head\");",
							"    ",
							"    // Verify terminating done frame",
							"    var doneFrame = lines[lines.length - 1];",
							"    pm.expect(doneFrame.type).to.eql(\"done\");",
							"    pm.expect(doneFrame.status).to.eql(\"OK\");",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"session_id\": \"sess-glossary-01\",\n    \"message\": \"What is Total Dynamic Head (TDH)?\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/query",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"query"
					]
				}
			},
			"response": []
		},
		{
			"name": "03A. CLARIFY Turn 1 - Ambiguous Question (Pauses)",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"pm.collectionVariables.set(\"clarify_session\", \"sess-clarify-\" + Math.random().toString(36).substring(7));"
						],
						"type": "text/javascript"
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"pm.test(\"Emits clarification frame and pauses\", function () {",
							"    var lines = pm.response.text().trim().split('\\n').map(function(l) { return JSON.parse(l); });",
							"    pm.expect(lines.length).to.be.at.least(2);",
							"    ",
							"    var clarifyFrame = lines.find(function(f) { return f.type === 'clarification'; });",
							"    pm.expect(clarifyFrame).to.not.be.undefined;",
							"    pm.expect(clarifyFrame.slot).to.eql(\"asset_id\");",
							"    pm.expect(clarifyFrame.options).to.be.an(\"array\").that.includes(\"FS-017\");",
							"    ",
							"    var doneFrame = lines[lines.length - 1];",
							"    pm.expect(doneFrame.type).to.eql(\"done\");",
							"    pm.expect(doneFrame.status).to.eql(\"PAUSED\");",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"session_id\": \"{{clarify_session}}\",\n    \"message\": \"Why did it trip?\"\n}"
