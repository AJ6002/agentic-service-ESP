							"    pm.expect(clarifyFrame).to.be.undefined;",
							"    ",
							"    // Must diagnose FS-017 directly",
							"    var textDelta = lines.find(function(f) { return f.type === 'text_delta'; });",
							"    pm.expect(textDelta).to.not.be.undefined;",
							"    pm.expect(textDelta.delta).to.include(\"FS-017\");",
							"    ",
							"    var doneFrame = lines[lines.length - 1];",
							"    pm.expect(doneFrame.status).to.eql(\"OK\");",
							"});"
						],
						"type": "text/javascript"
					}
				}
