  "item": [
    {
      "name": "01. KB Health Check",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Response time is within SLA (< 20000ms)\", function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(20000);",
              "});",
              "pm.test(\"Service is esp_kb_service and status ok\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.service).to.eql(\"esp_kb_service\");",
              "    pm.expect(jsonData.status).to.eql(\"ok\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{kb_url}}/health",
          "host": [
            "{{kb_url}}"
          ],
          "path": [
            "health"
          ]
        }
      },
      "response": []
    },
