    {
      "name": "03. Semantic Search - Motor Overtemp",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Response time is within SLA (< 20000ms)\", function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(20000);",
              "});",
              "pm.test(\"Search returned hits array with doc references\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property(\"hits\");",
              "    pm.expect(jsonData.hits).to.be.an(\"array\");",
              "    pm.expect(jsonData.hits.length).to.be.above(0);",
              "    var hit = jsonData.hits[0];",
              "    pm.expect(hit).to.have.property(\"doc_id\");",
              "    pm.expect(hit).to.have.property(\"score\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{kb_url}}/api/kb/search",
          "host": [
            "{{kb_url}}"
          ],
          "path": [
            "api",
            "kb",
