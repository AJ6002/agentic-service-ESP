# ==============================================================================
# ESP APM PLATFORM — SERVER 3 CONFIGURATION FILE
# ==============================================================================
# This configuration governs Server 3 (Operations Dashboard & ML Backend).
# Edit the parameters below to point to Server 1 (Digital Twin) and Server 2 (AI Agent).

# ------------------------------------------------------------------------------
# 1. SERVER 1 CONNECTIVITY (Digital Twin & Telemetry Stream)
# ------------------------------------------------------------------------------
# IP address or hostname of Server 1 running the Mosquitto MQTT broker:
MQTT_BROKER_HOST=192.168.1.155
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC=esp/#

# ------------------------------------------------------------------------------
# 2. SERVER 2 CONNECTIVITY (AI Agent & LLM Service)
# ------------------------------------------------------------------------------
# HTTP URL of Server 2 (Ubuntu 24.04 LTS) running the esp_agent Gateway:
AGENT_GATEWAY_URL=http://192.168.1.191:8090
LLM_GATEWAY_URL=http://192.168.1.191:8080/v1

# ------------------------------------------------------------------------------
# 3. SERVER 3 LOCAL SERVICE PORTS
# ------------------------------------------------------------------------------
# Backend Service (FastAPI + ML Diagnostic Engine)
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8090

# Frontend Dashboard (React Operations Command Center)
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=3000

# ------------------------------------------------------------------------------
# 4. SERVER 2 KNOWLEDGE BASE & SPECIALIST SERVICES
# ------------------------------------------------------------------------------
LLM_MODEL_NAME=Qwen2.5-Coder-3B-Instruct-Q4_K_M
POSTGRES_URL=postgresql://user:password@192.168.1.191:5432/esp_agent
NEO4J_URI=bolt://192.168.1.191:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
QDRANT_URL=http://192.168.1.191:6333
ADVAIT_API_URL=http://192.168.1.191:8000
