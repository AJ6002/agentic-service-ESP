<service>
  <id>esp-backend-service</id>
  <name>esp-backend-service</name>
  <description>ESP APM Platform Backend Service with ML Diagnostic Engine &amp; Live Telemetry MQTT Bridge (Port 8090)</description>
  <executable>%BASE%\..\..\.venv\Scripts\python.exe</executable>
  <arguments>run_backend.py</arguments>
  <workingdirectory>%BASE%\..</workingdirectory>
  <logpath>%BASE%\..\logs</logpath>
  <log mode="roll-by-size-time">
    <sizeThreshold>10240</sizeThreshold>
    <pattern>yyyy-MM-dd</pattern>
    <autoRollAtTime>00:00:00</autoRollAtTime>
    <zipOlderThanNumDays>5</zipOlderThanNumDays>
  </log>
  <startmode>Automatic</startmode>
  <delayedAutoStart>true</delayedAutoStart>
  <onfailure action="restart" delay="5 sec"/>
  <onfailure action="restart" delay="10 sec"/>
  <resetfailure>1 hour</resetfailure>
</service>
